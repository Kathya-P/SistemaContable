# Supabase Project URL (requerido tanto en Vercel como en local)
# Encuéntralo en Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase Anon Public Key (requerido para el frontend)
# Encuéntralo en Supabase > Project Settings > API > Project API Keys > anon public
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Supabase Service Role Secret Key (requerido para el backend Express / Serverless Function)
# IMPORTANTE: Nunca expongas esta clave con prefijo VITE_. Solo debe estar en el backend / Vercel.
# Encuéntralo en Supabase > Project Settings > API > Project API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-privada

# URL base de la API (opcional, por defecto es /api)
# En Vercel no es necesario configurarlo porque las rutas /api se resuelven en el mismo dominio
VITE_API_URL=/api

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

